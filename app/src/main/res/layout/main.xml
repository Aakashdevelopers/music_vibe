<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:id="@+id/CDZEN"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#000000">

		<LinearLayout
			android:id="@+id/Ln_items"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#000000"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical"
			android:paddingLeft="0dp"
			android:paddingTop="0dp"
			android:paddingRight="0dp">

			<!-- Top Toolbar Hidden/Removed -->
			<LinearLayout
				android:id="@+id/linear42"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:visibility="gone">

				<LinearLayout
					android:id="@+id/linear43"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="8dp">

					<de.hdodenhof.circleimageview.CircleImageView
						android:id="@+id/profile"
						android:layout_width="45dp"
						android:layout_height="45dp"
						android:src="@drawable/logo"
						app:civ_border_color="#FFFFFF"
						app:civ_border_overlay="true"
						app:civ_border_width="0dp"
						app:civ_circle_background_color="#FFFFFF" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/linear45"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:gravity="center_vertical"
					android:orientation="vertical"
					android:padding="6dp">

					<TextView
						android:id="@+id/textview10"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingLeft="1dp"
						android:paddingTop="8dp"
						android:paddingRight="8dp"
						android:paddingBottom="2dp"
						android:text="Music Vibe"
						android:textColor="#FFFFFF"
						android:textSize="18sp"
						android:textStyle="bold" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/linear44"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:padding="8dp">

					<LinearLayout
						android:id="@+id/linear46"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginRight="8dp"
						android:orientation="vertical"
						android:padding="8dp">

						<ImageView
							android:id="@+id/imageview18"
							android:layout_width="30dp"
							android:layout_height="30dp"
							android:padding="5dp"
							android:scaleType="centerCrop"
							android:src="@drawable/icon_search_roundy" />
					</LinearLayout>

					<LinearLayout
						android:id="@+id/linear47"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="8dp">

						<ImageView
							android:id="@+id/imageview19"
							android:layout_width="30dp"
							android:layout_height="30dp"
							android:padding="5dp"
							android:scaleType="centerCrop"
							android:src="@drawable/icon_notifications_round" />
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>

			<RelativeLayout
				android:id="@+id/Relative"
				android:layout_width="match_parent"
				android:layout_height="match_parent">

				<androidx.viewpager.widget.ViewPager
					android:id="@+id/viewpager1"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:paddingLeft="0dp"
					android:paddingRight="0dp" />

				<LinearLayout
					android:id="@+id/ln_all_menudown"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:gravity="bottom"
					android:orientation="vertical"
					android:paddingLeft="8dp"
					android:paddingTop="8dp"
					android:paddingRight="8dp"
					android:paddingBottom="45dp">

					<!-- Mini Player Container -->
					<LinearLayout
						android:id="@+id/Ln_mini_nav"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="8dp"
						android:background="@drawable/bg_mini_player"
						android:elevation="6dp"
						android:orientation="vertical"
						android:visibility="gone">

						<LinearLayout
							android:id="@+id/linear10"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="vertical"
							android:paddingHorizontal="12dp"
							android:paddingTop="10dp"
							android:paddingBottom="10dp">

							<!-- Song Row -->
							<LinearLayout
								android:id="@+id/linear54"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal">

								<androidx.cardview.widget.CardView
									android:id="@+id/cardview1"
									android:layout_width="44dp"
									android:layout_height="44dp"
									app:cardBackgroundColor="#12141F"
									app:cardCornerRadius="10dp"
									app:cardElevation="0dp">

									<ImageView
										android:id="@+id/prevArt"
										android:layout_width="match_parent"
										android:layout_height="match_parent"
										android:contentDescription="Album Artwork"
										android:scaleType="centerCrop"
										android:src="@drawable/zenloading_error" />
								</androidx.cardview.widget.CardView>

								<LinearLayout
									android:id="@+id/linear14"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:layout_marginStart="12dp"
									android:layout_marginEnd="8dp"
									android:layout_weight="1"
									android:gravity="center_vertical"
									android:orientation="vertical">

									<TextView
										android:id="@+id/prevname"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:ellipsize="end"
										android:fontFamily="sans-serif-medium"
										android:maxLines="1"
										android:singleLine="true"
										android:text="Song Name"
										android:textColor="#FFFFFF"
										android:textSize="14sp"
										android:textStyle="bold" />

									<TextView
										android:id="@+id/prevartista"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:layout_marginTop="2dp"
										android:ellipsize="end"
										android:fontFamily="sans-serif"
										android:maxLines="1"
										android:singleLine="true"
										android:text="Artist Name"
										android:textColor="#A0A0B0"
										android:textSize="12sp" />
								</LinearLayout>

								<LinearLayout
									android:id="@+id/linear15"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:gravity="center"
									android:orientation="vertical"
									android:padding="4dp">

									<ImageView
										android:id="@+id/prevplaypause"
										android:layout_width="30dp"
										android:layout_height="30dp"
										android:background="?android:attr/selectableItemBackgroundBorderless"
										android:clickable="true"
										android:contentDescription="Play or Pause"
										android:focusable="true"
										android:padding="2dp"
										android:scaleType="fitCenter"
										android:src="@drawable/icon_play_arrow_round"
										app:tint="#FFFFFF" />
								</LinearLayout>
							</LinearLayout>

							<!-- Progress Bar inside Mini Player -->
							<LinearLayout
								android:id="@+id/linear55"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginTop="8dp"
								android:orientation="horizontal">

								<ProgressBar
									android:id="@+id/progressbar1"
									style="?android:progressBarStyleHorizontal"
									android:layout_width="match_parent"
									android:layout_height="3dp"
									android:indeterminate="false"
									android:progressDrawable="@drawable/bg_mini_progress" />
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>

					<LinearLayout
						android:id="@+id/linear56"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="@android:color/transparent"
						android:orientation="horizontal">

						<LinearLayout
							android:id="@+id/bottom_nav"
							android:layout_width="match_parent"
							android:layout_height="62dp"
							android:layout_marginTop="8dp"
							android:background="@drawable/bg_bottom_nav"
							android:elevation="8dp"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:paddingHorizontal="4dp"
							android:paddingVertical="4dp">

							<LinearLayout
								android:id="@+id/nav_home_layout"
								android:layout_width="0dp"
								android:layout_height="match_parent"
								android:layout_marginHorizontal="1dp"
								android:layout_weight="1"
								android:background="@drawable/bg_selected_nav"
								android:clickable="true"
								android:focusable="true"
								android:gravity="center"
								android:orientation="horizontal"
								android:paddingHorizontal="4dp">

								<ImageView
									android:id="@+id/nav_home"
									android:layout_width="20dp"
									android:layout_height="20dp"
									android:contentDescription="Home"
									android:scaleType="fitCenter"
									android:src="@drawable/icon_home_round"
									app:tint="#A78BFA" />

								<TextView
									android:id="@+id/txt_home"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginStart="4dp"
									android:ellipsize="none"
									android:fontFamily="sans-serif-medium"
									android:maxLines="1"
									android:singleLine="true"
									android:text="Home"
									android:textColor="#A78BFA"
									android:textSize="11sp"
									android:textStyle="bold" />
							</LinearLayout>

							<LinearLayout
								android:id="@+id/nav_search_layout"
								android:layout_width="0dp"
								android:layout_height="match_parent"
								android:layout_marginHorizontal="1dp"
								android:layout_weight="1"
								android:clickable="true"
								android:focusable="true"
								android:gravity="center"
								android:orientation="horizontal"
								android:paddingHorizontal="4dp">

								<ImageView
									android:id="@+id/nav_search"
									android:layout_width="20dp"
									android:layout_height="20dp"
									android:contentDescription="Search"
									android:scaleType="fitCenter"
									android:src="@drawable/icon_search_roundy"
									app:tint="#808080" />

								<TextView
									android:id="@+id/txt_search"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginStart="4dp"
									android:ellipsize="none"
									android:fontFamily="sans-serif-medium"
									android:maxLines="1"
									android:singleLine="true"
									android:text="Search"
									android:textColor="#808080"
									android:textSize="11sp"
									android:textStyle="bold"
									android:visibility="gone" />
							</LinearLayout>

							<LinearLayout
								android:id="@+id/nav_download_layout"
								android:layout_width="0dp"
								android:layout_height="match_parent"
								android:layout_marginHorizontal="1dp"
								android:layout_weight="1"
								android:clickable="true"
								android:focusable="true"
								android:gravity="center"
								android:orientation="horizontal"
								android:paddingHorizontal="4dp">

								<ImageView
									android:id="@+id/nav_download"
									android:layout_width="20dp"
									android:layout_height="20dp"
									android:contentDescription="Downloads"
									android:scaleType="fitCenter"
									android:src="@drawable/icon_arrow_downward_round"
									app:tint="#808080" />

								<TextView
									android:id="@+id/txt_download"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginStart="4dp"
									android:ellipsize="none"
									android:fontFamily="sans-serif-medium"
									android:maxLines="1"
									android:singleLine="true"
									android:text="Downloads"
									android:textColor="#808080"
									android:textSize="11sp"
									android:textStyle="bold"
									android:visibility="gone" />
							</LinearLayout>

							<LinearLayout
								android:id="@+id/nav_setting_layout"
								android:layout_width="0dp"
								android:layout_height="match_parent"
								android:layout_marginHorizontal="1dp"
								android:layout_weight="1"
								android:clickable="true"
								android:focusable="true"
								android:gravity="center"
								android:orientation="horizontal"
								android:paddingHorizontal="4dp">

								<ImageView
									android:id="@+id/nav_setting"
									android:layout_width="20dp"
									android:layout_height="20dp"
									android:contentDescription="Settings"
									android:scaleType="fitCenter"
									android:src="@drawable/icon_settings_round"
									app:tint="#808080" />

								<TextView
									android:id="@+id/txt_setting"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginStart="4dp"
									android:ellipsize="none"
									android:fontFamily="sans-serif-medium"
									android:maxLines="1"
									android:singleLine="true"
									android:text="Settings"
									android:textColor="#808080"
									android:textSize="11sp"
									android:textStyle="bold"
									android:visibility="gone" />
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</RelativeLayout>
		</LinearLayout>

		<LinearLayout
			android:id="@+id/FULL_PLAYER_ZENSOUND"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#1A1A1A"
			android:elevation="0dp"
			android:orientation="vertical"
			android:paddingTop="100dp"
			android:paddingBottom="45dp"
			app:behavior_peekHeight="0dp"
			app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

			<LinearLayout
				android:id="@+id/PLAYER_TOP"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="33dp"
				android:layout_marginRight="33dp"
				android:layout_weight="1"
				android:orientation="vertical">

				<androidx.cardview.widget.CardView
					android:id="@+id/cardview2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:cardBackgroundColor="#000000"
					app:cardCornerRadius="32dp"
					app:cardElevation="0dp">

					<com.theophrast.ui.widget.SquareImageView
						android:id="@+id/albumArt"
						android:layout_width="match_parent"
						android:layout_height="wrap_content" />
				</androidx.cardview.widget.CardView>

				<LinearLayout
					android:id="@+id/linear19"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">

					<TextView
						android:id="@+id/songName"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingTop="15dp"
						android:text="Name song"
						android:textColor="#FFFFFF"
						android:textSize="25sp"
						android:textStyle="bold" />

					<LinearLayout
						android:id="@+id/linear35"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal">

						<TextView
							android:id="@+id/artistName"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:paddingTop="8dp"
							android:paddingBottom="8dp"
							android:text="Artist or collaborations"
							android:textColor="#BDBDBD"
							android:textSize="14sp" />

						<LinearLayout
							android:id="@+id/Btmorre"
							android:layout_width="38dp"
							android:layout_height="38dp"
							android:background="#424242"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical">

							<ImageView
								android:id="@+id/imageview13"
								android:layout_width="25dp"
								android:layout_height="25dp"
								android:scaleType="centerCrop"
								android:src="@drawable/dow" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>

				<HorizontalScrollView
					android:id="@+id/hscroll1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:fadeScrollbars="false"
					android:fadingEdgeLength="50dp"
					android:fillViewport="true"
					android:requiresFadingEdge="horizontal"
					android:scrollbars="none">

					<LinearLayout
						android:id="@+id/linear20"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:orientation="horizontal"
						android:paddingTop="8dp"
						android:paddingBottom="8dp">

						<LinearLayout
							android:id="@+id/fav"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginRight="8dp"
							android:background="#424242"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="horizontal"
							android:paddingLeft="16dp"
							android:paddingTop="2dp"
							android:paddingRight="16dp"
							android:paddingBottom="2dp">

							<TextView
								android:id="@+id/textview7"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:text="Favorite"
								android:textColor="#FFFFFF"
								android:textSize="12sp" />

							<ImageView
								android:id="@+id/imageview7"
								android:layout_width="25dp"
								android:layout_height="25dp"
								android:scaleType="centerCrop"
								android:src="@drawable/icon_favorite_border_round" />
						</LinearLayout>

						<LinearLayout
							android:id="@+id/repeat"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:background="#424242"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="horizontal"
							android:paddingLeft="16dp"
							android:paddingTop="2dp"
							android:paddingRight="16dp"
							android:paddingBottom="2dp">

							<TextView
								android:id="@+id/textview9"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:text="Repeat song"
								android:textColor="#FFFFFF"
								android:textSize="12sp" />

							<ImageView
								android:id="@+id/imageview9"
								android:layout_width="25dp"
								android:layout_height="25dp"
								android:scaleType="centerCrop"
								android:src="@drawable/icon_repeat_round" />
						</LinearLayout>

						<LinearLayout
							android:id="@+id/time"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginLeft="8dp"
							android:background="#424242"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="horizontal"
							android:paddingLeft="16dp"
							android:paddingTop="2dp"
							android:paddingRight="16dp"
							android:paddingBottom="2dp">

							<TextView
								android:id="@+id/textview8"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:text="Next songs"
								android:textColor="#FFFFFF"
								android:textSize="12sp" />

							<ImageView
								android:id="@+id/imageview8"
								android:layout_width="25dp"
								android:layout_height="25dp"
								android:scaleType="centerCrop"
								android:src="@drawable/icon_skip_next_round" />
						</LinearLayout>
					</LinearLayout>
				</HorizontalScrollView>
			</LinearLayout>

			<LinearLayout
				android:id="@+id/PLAYER_DOWN"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="bottom"
				android:orientation="vertical"
				android:paddingLeft="20dp"
				android:paddingRight="20dp">

				<LinearLayout
					android:id="@+id/linear29"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">

					<FrameLayout
						android:id="@+id/slider"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginHorizontal="0dp"
						android:layout_marginBottom="0.0dp"
						android:orientation="horizontal">

						<SeekBar
							android:id="@+id/seekBar"
							style="@style/MediaPlayer.ProgressBar"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:thumbTint="?attr/colorPrimary"
							android:visibility="gone"
							app:labelBehavior="gone"
							tools:visibility="visible" />
					</FrameLayout>

					<LinearLayout
						android:id="@+id/linear31"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal"
						android:paddingLeft="13dp"
						android:paddingRight="13dp">

						<LinearLayout
							android:id="@+id/linear32"
							android:layout_width="wrap_content"
							android:layout_height="match_parent"
							android:orientation="vertical">

							<TextView
								android:id="@+id/currentTime"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="00:00"
								android:textColor="#FFFFFF"
								android:textSize="12sp" />
						</LinearLayout>

						<LinearLayout
							android:id="@+id/linear33"
							android:layout_width="wrap_content"
							android:layout_height="match_parent"
							android:layout_weight="1"
							android:orientation="vertical"
							android:padding="8dp" />

						<LinearLayout
							android:id="@+id/linear34"
							android:layout_width="wrap_content"
							android:layout_height="match_parent"
							android:orientation="vertical">

							<TextView
								android:id="@+id/totalTime"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="00:00"
								android:textColor="#FFFFFF"
								android:textSize="12sp" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>

			<LinearLayout
				android:id="@+id/linear36"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="33dp"
				android:layout_marginRight="33dp"
				android:gravity="bottom"
				android:orientation="vertical">

				<LinearLayout
					android:id="@+id/linear25"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal">

					<LinearLayout
						android:id="@+id/linear26"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:layout_weight="1"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical"
						android:padding="8dp">

						<ImageView
							android:id="@+id/prev"
							android:layout_width="40dp"
							android:layout_height="40dp"
							android:scaleType="centerCrop"
							android:src="@drawable/icon_skip_previous_round" />
					</LinearLayout>

					<LinearLayout
						android:id="@+id/linear27"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:layout_weight="1"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical"
						android:padding="8dp">

						<LinearLayout
							android:id="@+id/linear37"
							android:layout_width="wrap_content"
							android:layout_height="match_parent"
							android:background="#424242"
							android:orientation="vertical"
							android:padding="15dp">

							<ImageView
								android:id="@+id/playPauseBtn"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:scaleType="center"
								android:src="@drawable/icon_play_arrow_round" />
						</LinearLayout>
					</LinearLayout>

					<LinearLayout
						android:id="@+id/linear28"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:layout_weight="1"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical"
						android:padding="8dp">

						<ImageView
							android:id="@+id/next"
							android:layout_width="40dp"
							android:layout_height="40dp"
							android:scaleType="centerCrop"
							android:src="@drawable/icon_skip_next_round" />
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
