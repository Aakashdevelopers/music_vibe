<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:id="@+id/CDZEN"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#1A1A1A">
		<LinearLayout
			android:id="@+id/Ln_items"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingLeft="10dp"
			android:paddingTop="35dp"
			android:paddingRight="10dp"
			android:background="#000000"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear42"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear43"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="vertical">
					<de.hdodenhof.circleimageview.CircleImageView
						android:id="@+id/profile"
						android:layout_width="45dp"
						android:layout_height="45dp"
						android:src="@drawable/logo"
						app:civ_border_width="0dp"
						app:civ_border_color="#FFFFFF"
						app:civ_circle_background_color="#FFFFFF"
						app:civ_border_overlay="true" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear45"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:padding="6dp"
					android:gravity="center_vertical"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:id="@+id/textview10"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingLeft="1dp"
						android:paddingTop="8dp"
						android:paddingRight="8dp"
						android:paddingBottom="2dp"
						android:text="Music Vibe"
						android:textSize="18sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear44"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/linear46"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginRight="8dp"
						android:padding="8dp"
						android:orientation="vertical">
						<ImageView
							android:id="@+id/imageview18"
							android:layout_width="30dp"
							android:layout_height="30dp"
							android:padding="5dp"
							android:src="@drawable/icon_search_roundy"
							android:scaleType="centerCrop" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear47"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:orientation="vertical">
						<ImageView
							android:id="@+id/imageview19"
							android:layout_width="30dp"
							android:layout_height="30dp"
							android:padding="5dp"
							android:src="@drawable/icon_notifications_round"
							android:scaleType="centerCrop" />
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
			<RelativeLayout
				android:id="@+id/Relative"
				android:layout_width="match_parent"
				android:layout_height="match_parent">
				<androidx.viewpager.widget.ViewPager
					android:id="@+id/viewpager1"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:paddingLeft="4dp"
					android:paddingRight="4dp" />
				<LinearLayout
					android:id="@+id/ln_all_menudown"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:paddingLeft="8dp"
					android:paddingTop="8dp"
					android:paddingRight="8dp"
					android:paddingBottom="45dp"
					android:gravity="bottom"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/Ln_mini_nav"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="#FFFFFF"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/linear10"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:paddingLeft="12dp"
							android:paddingTop="9dp"
							android:paddingRight="12dp"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical">
							<LinearLayout
								android:id="@+id/linear54"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="horizontal">
								<androidx.cardview.widget.CardView
									android:id="@+id/cardview1"
									android:layout_width="45dp"
									android:layout_height="45dp"
									app:cardBackgroundColor="#000000"
									app:cardElevation="0dp"
									app:cardCornerRadius="11dp">
									<ImageView
										android:id="@+id/prevArt"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:src="@drawable/zenloading_error"
										android:scaleType="centerCrop" />
								</androidx.cardview.widget.CardView>
								<LinearLayout
									android:id="@+id/linear14"
									android:layout_width="wrap_content"
									android:layout_height="match_parent"
									android:layout_marginRight="8dp"
									android:paddingLeft="8dp"
									android:paddingRight="8dp"
									android:gravity="center_vertical"
									android:orientation="vertical"
									android:layout_weight="1">
									<TextView
										android:id="@+id/prevname"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:text="Name Song "
										android:textSize="14sp"
										android:textColor="#FFFFFF" />
									<TextView
										android:id="@+id/prevartista"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:text="Name Artist"
										android:textSize="12sp"
										android:textColor="#9E9E9E" />
								</LinearLayout>
								<LinearLayout
									android:id="@+id/linear15"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:padding="8dp"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical">
									<ImageView
										android:id="@+id/prevplaypause"
										android:layout_width="30dp"
										android:layout_height="30dp"
										android:src="@drawable/icon_play_arrow_round"
										android:scaleType="centerCrop" />
								</LinearLayout>
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear55"
								android:layout_width="match_parent"
								android:layout_height="8dp"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="horizontal">
								<ProgressBar
									android:id="@+id/progressbar1"
									android:layout_width="match_parent"
									android:layout_height="1dp"
									android:layout_marginBottom="1dp"
									android:indeterminate="false"
									style="?android:progressBarStyleHorizontal" />
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear56"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="@android:color/transparent"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/bottom_nav"
							android:layout_width="match_parent"
							android:layout_height="65dp"
							android:layout_marginTop="5dp"
							android:padding="3dp"
							android:background="@drawable/bg_bottom_nav"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="horizontal"
							android:weightSum="4">
							<LinearLayout
								android:id="@+id/nav_home_layout"
								android:layout_width="0dp"
								android:layout_height="match_parent"
								android:padding="6dp"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="horizontal"
								android:layout_weight="1">
								<ImageView
									android:id="@+id/nav_home"
									android:layout_width="22dp"
									android:layout_height="22dp"
									android:src="@drawable/icon_home_round"
									android:scaleType="fitCenter"
									android:tint="#A78BFA" />
								<TextView
									android:id="@+id/txt_home"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="5dp"
									android:text="Home"
									android:textSize="12sp"
									android:textColor="#A78BFA" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/nav_search_layout"
								android:layout_width="0dp"
								android:layout_height="match_parent"
								android:padding="6dp"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="horizontal"
								android:layout_weight="1">
								<ImageView
									android:id="@+id/nav_search"
									android:layout_width="22dp"
									android:layout_height="22dp"
									android:src="@drawable/icon_search_roundy"
									android:scaleType="fitCenter"
									android:tint="#808080" />
								<TextView
									android:id="@+id/txt_search"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="5dp"
									android:text="Search"
									android:textSize="12sp"
									android:textColor="#808080"
									android:visibility="gone" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/nav_download_layout"
								android:layout_width="0dp"
								android:layout_height="match_parent"
								android:padding="6dp"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="horizontal"
								android:layout_weight="1">
								<ImageView
									android:id="@+id/nav_download"
									android:layout_width="22dp"
									android:layout_height="22dp"
									android:src="@drawable/icon_arrow_downward_round"
									android:scaleType="fitCenter"
									android:tint="#808080" />
								<TextView
									android:id="@+id/txt_download"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="5dp"
									android:text="Download"
									android:textSize="12sp"
									android:textColor="#808080"
									android:singleLine="true"
									android:visibility="gone"
									android:maxLines="1"
									android:ellipsize="end" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/nav_setting_layout"
								android:layout_width="0dp"
								android:layout_height="match_parent"
								android:padding="6dp"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="horizontal"
								android:layout_weight="1">
								<ImageView
									android:id="@+id/nav_setting"
									android:layout_width="22dp"
									android:layout_height="22dp"
									android:src="@drawable/icon_settings_round"
									android:scaleType="fitCenter"
									android:tint="#808080" />
								<TextView
									android:id="@+id/txt_setting"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="5dp"
									android:text="Setting"
									android:textSize="12sp"
									android:textColor="#808080"
									android:visibility="gone" />
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</RelativeLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/FULL_PLAYER_ZENSOUND"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingTop="100dp"
			android:paddingBottom="45dp"
			android:background="#1A1A1A"
			android:orientation="vertical"
			app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
			app:behavior_peekHeight="0dp"
			android:elevation="0dp">
			<LinearLayout
				android:id="@+id/PLAYER_TOP"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="33dp"
				android:layout_marginRight="33dp"
				android:orientation="vertical"
				android:layout_weight="1">
				<androidx.cardview.widget.CardView
					android:id="@+id/cardview2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:cardBackgroundColor="#000000"
					app:cardElevation="0dp"
					app:cardCornerRadius="32dp">
					<com.theophrast.ui.widget.SquareImageView
						android:id="@+id/albumArt"
						android:layout_width="match_parent"
						android:layout_height="wrap_content" />
				</androidx.cardview.widget.CardView>
				<LinearLayout
					android:id="@+id/linear19"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">
					<TextView
						android:id="@+id/songName"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingTop="15dp"
						android:text="Name song"
						android:textSize="25sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF" />
					<LinearLayout
						android:id="@+id/linear35"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/artistName"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:paddingTop="8dp"
							android:paddingBottom="8dp"
							android:text="Artist or collaborations"
							android:textSize="14sp"
							android:textColor="#BDBDBD"
							android:layout_weight="1" />
						<LinearLayout
							android:id="@+id/Btmorre"
							android:layout_width="38dp"
							android:layout_height="38dp"
							android:background="#424242"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical">
							<ImageView
								android:id="@+id/imageview13"
								android:layout_width="25dp"
								android:layout_height="25dp"
								android:src="@drawable/dow"
								android:scaleType="centerCrop" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
				<HorizontalScrollView
					android:id="@+id/hscroll1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:scrollbars="none"
					android:fillViewport="true"
					android:fadingEdgeLength="50dp"
					android:requiresFadingEdge="horizontal"
					android:fadeScrollbars="false">
					<LinearLayout
						android:id="@+id/linear20"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingTop="8dp"
						android:paddingBottom="8dp"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/fav"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginRight="8dp"
							android:paddingLeft="16dp"
							android:paddingTop="2dp"
							android:paddingRight="16dp"
							android:paddingBottom="2dp"
							android:background="#424242"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="horizontal">
							<TextView
								android:id="@+id/textview7"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:text="Favorite"
								android:textSize="12sp"
								android:textColor="#FFFFFF" />
							<ImageView
								android:id="@+id/imageview7"
								android:layout_width="25dp"
								android:layout_height="25dp"
								android:src="@drawable/icon_favorite_border_round"
								android:scaleType="centerCrop" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/repeat"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:paddingLeft="16dp"
							android:paddingTop="2dp"
							android:paddingRight="16dp"
							android:paddingBottom="2dp"
							android:background="#424242"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="horizontal">
							<TextView
								android:id="@+id/textview9"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:text="Repeat song"
								android:textSize="12sp"
								android:textColor="#FFFFFF" />
							<ImageView
								android:id="@+id/imageview9"
								android:layout_width="25dp"
								android:layout_height="25dp"
								android:src="@drawable/icon_repeat_round"
								android:scaleType="centerCrop" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/time"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginLeft="8dp"
							android:paddingLeft="16dp"
							android:paddingTop="2dp"
							android:paddingRight="16dp"
							android:paddingBottom="2dp"
							android:background="#424242"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="horizontal">
							<TextView
								android:id="@+id/textview8"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:text="Next songs"
								android:textSize="12sp"
								android:textColor="#FFFFFF" />
							<ImageView
								android:id="@+id/imageview8"
								android:layout_width="25dp"
								android:layout_height="25dp"
								android:src="@drawable/icon_skip_next_round"
								android:scaleType="centerCrop" />
						</LinearLayout>
					</LinearLayout>
				</HorizontalScrollView>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/PLAYER_DOWN"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="20dp"
				android:paddingRight="20dp"
				android:gravity="bottom"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear29"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">
					<FrameLayout
						android:id="@+id/slider"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal"
						android:layout_marginBottom="0.0dp"
						android:layout_marginHorizontal="0dp">
						<SeekBar
							android:id="@+id/seekBar"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							style="@style/MediaPlayer.ProgressBar"
							android:thumbTint="?attr/colorPrimary"
							android:visibility="gone"
							app:labelBehavior="gone"
							tools:visibility="visible" />
					</FrameLayout>
					<LinearLayout
						android:id="@+id/linear31"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingLeft="13dp"
						android:paddingRight="13dp"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear32"
							android:layout_width="wrap_content"
							android:layout_height="match_parent"
							android:orientation="vertical">
							<TextView
								android:id="@+id/currentTime"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="00:00"
								android:textSize="12sp"
								android:textColor="#FFFFFF" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear33"
							android:layout_width="wrap_content"
							android:layout_height="match_parent"
							android:padding="8dp"
							android:orientation="vertical"
							android:layout_weight="1" />
						<LinearLayout
							android:id="@+id/linear34"
							android:layout_width="wrap_content"
							android:layout_height="match_parent"
							android:orientation="vertical">
							<TextView
								android:id="@+id/totalTime"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="00:00"
								android:textSize="12sp"
								android:textColor="#FFFFFF" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear36"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="33dp"
				android:layout_marginRight="33dp"
				android:gravity="bottom"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear25"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/linear26"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical"
						android:layout_weight="1">
						<ImageView
							android:id="@+id/prev"
							android:layout_width="40dp"
							android:layout_height="40dp"
							android:src="@drawable/icon_skip_previous_round"
							android:scaleType="centerCrop" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear27"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical"
						android:layout_weight="1">
						<LinearLayout
							android:id="@+id/linear37"
							android:layout_width="wrap_content"
							android:layout_height="match_parent"
							android:padding="15dp"
							android:background="#424242"
							android:orientation="vertical">
							<ImageView
								android:id="@+id/playPauseBtn"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:src="@drawable/icon_play_arrow_round"
								android:scaleType="center" />
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear28"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical"
						android:layout_weight="1">
						<ImageView
							android:id="@+id/next"
							android:layout_width="40dp"
							android:layout_height="40dp"
							android:src="@drawable/icon_skip_next_round"
							android:scaleType="centerCrop" />
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
