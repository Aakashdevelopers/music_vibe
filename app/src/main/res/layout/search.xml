<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/linear1"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?android:attr/selectableItemBackground"
	android:clickable="true"
	android:focusable="true"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:paddingHorizontal="16dp"
	android:paddingVertical="8dp">

	<!-- Album Art -->
	<androidx.cardview.widget.CardView
		android:id="@+id/mAlbumCard"
		android:layout_width="52dp"
		android:layout_height="52dp"
		app:cardBackgroundColor="#1A1A26"
		app:cardCornerRadius="6dp"
		app:cardElevation="0dp">

		<LinearLayout
			android:id="@+id/linear5"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@android:color/transparent"
			android:orientation="vertical">

			<ImageView
				android:id="@+id/ArtZen"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:contentDescription="Album Art"
				android:focusable="false"
				android:scaleType="centerCrop"
				android:src="@drawable/default_music_image" />
		</LinearLayout>
	</androidx.cardview.widget.CardView>

	<!-- Music Info -->
	<LinearLayout
		android:id="@+id/mMusicInfoMiddle"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="12dp"
		android:layout_marginEnd="8dp"
		android:layout_weight="1"
		android:gravity="center_vertical"
		android:orientation="vertical">

		<TextView
			android:id="@+id/TnameZen"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:focusable="false"
			android:fontFamily="sans-serif-medium"
			android:maxLines="1"
			android:singleLine="true"
			android:text="Song Title"
			android:textColor="#FFFFFF"
			android:textSize="14sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/TartistZen"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:ellipsize="end"
			android:focusable="false"
			android:fontFamily="sans-serif"
			android:maxLines="1"
			android:singleLine="true"
			android:text="Artist Name"
			android:textColor="#9E9EB0"
			android:textSize="12sp" />
	</LinearLayout>

	<!-- Play Icon -->
</LinearLayout>
