<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#000000"
	android:orientation="vertical">

	<androidx.core.widget.NestedScrollView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:overScrollMode="never"
		android:scrollbars="none">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingBottom="120dp">

			<!-- Top Header with status bar clearance -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingHorizontal="16dp"
				android:paddingTop="42dp"
				android:paddingBottom="16dp">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:fontFamily="sans-serif-medium"
					android:text="Settings"
					android:textColor="#FFFFFF"
					android:textSize="24sp"
					android:textStyle="bold" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:fontFamily="sans-serif"
					android:text="App preferences and information"
					android:textColor="#A0A0B0"
					android:textSize="13sp" />
			</LinearLayout>

			<!-- Settings Options List -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingHorizontal="16dp">

				<!-- Audio Quality Option -->
				<LinearLayout
					android:id="@+id/btnAudioQuality"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="12dp"
					android:background="@drawable/bg_chip_glassy_unselected"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:padding="16dp">

					<ImageView
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:contentDescription="Audio Quality"
						android:src="@drawable/icon_music_note_round"
						app:tint="#A78BFA" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginStart="16dp"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Audio Streaming Quality"
							android:textColor="#FFFFFF"
							android:textSize="15sp"
							android:textStyle="bold" />

						<TextView
							android:id="@+id/tvQualitySubtitle"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:text="Auto (Network Speed Adaptive)"
							android:textColor="#A0A0B0"
							android:textSize="12sp" />
					</LinearLayout>
				</LinearLayout>

				<!-- Equalizer Option -->

				<!-- Check for Updates / App Version Option -->
				<LinearLayout
					android:id="@+id/btnCheckUpdate"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_chip_glassy_unselected"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:padding="16dp">

					<ImageView
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:contentDescription="Check for Updates"
						android:src="@drawable/icon_arrow_downward_round"
						app:tint="#A78BFA" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginStart="16dp"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Check for Updates"
							android:textColor="#FFFFFF"
							android:textSize="15sp"
							android:textStyle="bold" />

						<TextView
							android:id="@+id/tvVersionSubtitle"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:text="Version 1.4 • Tap to check GitHub"
							android:textColor="#A0A0B0"
							android:textSize="12sp" />
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>
